# ============================================================================
# taller-cifrado.service — Servicio de systemd
# Universidad El Bosque — Seguridad de la Información — 2026-II
#
# Instalación en la instancia EC2:
#   sudo cp deploy/taller-cifrado.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now taller-cifrado
#
# Ajusta WorkingDirectory si tu carpeta no es /home/ec2-user/Proyecto_cifrado.
# ============================================================================

[Unit]
Description=Taller de cifrado clasico y modulo de inicio de sesion
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/Proyecto_cifrado
ExecStart=/usr/bin/node server.js

# Variables no secretas. PORT solo se usa en modo HTTP (sin certificado).
Environment=PORT=80
Environment=NODE_ENV=production

# Archivo de configuración con permisos 600. Contiene:
#   SESSION_SECRET=...           siempre
#   TLS_CERT=... y TLS_KEY=...   para activar HTTPS (Fases S2 y S3)
#   DOMINIO=www.tudominio.xyz    nombre canónico para la redirección
# Editar este archivo y reiniciar el servicio es la activación manual del
# certificado. No va aquí porque los archivos de systemd los lee cualquiera.
EnvironmentFile=/etc/taller-cifrado.env

# Permite abrir los puertos 80 y 443 sin ejecutar el proceso como root.
AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
